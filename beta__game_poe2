                    <div class="start" tooltip="Restart condition" tooltip-position="bottom snap-left" onClick="Simulator.editLink(this,'start')">
                        <svg viewBox="0 0 16 16">
                            <use href="assets/shared/ui/simulator-start.svg#home"></use>
                        </svg>
                    </div>
                    <div class="link-action" onClick="Simulator.linkAction(this)">
                        <div class="link" tooltip="New link" tooltip-position="bottom snap-left">
