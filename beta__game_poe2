                                        <div class="label flex-grow">Items completed</div>
                                        <div id="simulatorStatItemsCompleted" class="simulatorStat"></div>
                                    </div>
                                    <div class="flex align-center gap-sml">
                                        <div class="label flex-grow">Success chance</div>
                                        <div id="simulatorStatSuccessChance" class="simulatorStat"></div>
                                    </div>
                                    <div class="flex align-center gap-sml">
                                        <div class="label flex-grow">Target</div>
                                        <div id="simulatorStatTarget" class="simulatorStat"></div>
                                    </div>
