                        <div id="simulatorLayout" class="simulatorBlock layout flex">
                            <div class="sidebar setup">
                                <div class="flex flex-columns gap">
                                    <div class="options flex flex-columns gap">
                                        <div class="option flex flex-columns">
                                            <label>Starting step</label>
                                            <div class="content flex flex-columns">
                                                <button onClick="Simulator.selectStartingStep()" id="simulationStartingStepButton">Automatic</button>
                                            </div>
                                        </div>
                                    </div>
                                    <button onClick="Simulator.addStep()">Add a step</button>
