                            <div class="options flex flex-end gap"></div>
                            <div id="simulatorStepActionChooser" class="action flex flex-columns gap"></div>
                            <div class="links">
                                <label class="flex">Route priority order</label>
                                <div class="routeOrder flex flex-columns gap-sml"></div>
                            </div>
                            <div class="extendedOptions"></div>
                        </div>
                        <div id="simulatorConditionEditor" class="simulatorBlock hidden">
                            <div class="simulatorTitle">Link edition</div>
                            <div class="header flex align-center gap">
                                <button onClick="Simulator.removeLink()" class="removeLinkButton">Remove link</button>
                                <button onClick="Simulator.changeTarget()" class="changeTargetButton">Change target</button>
                                <div class="titleHolder flex-grow flex align-center gap">
                                    <svg viewBox="0 0 16 16" class="link">
                                        <use href="assets/shared/ui/route-link.svg#link"></use>
                                    </svg>
                                    <div id="simulatorConditionFrom"></div>
                                    <img src="assets/shared/ui/arrow-separator.webp" />
                                    <div id="simulatorConditionTo"></div>
                                </div>
                                <button onClick="Simulator.saveLink()"><img src='assets/shared/ui/on_success.webp'>Apply changes</button>
                                <button onClick="Simulator.backToLayout()"><img src='assets/shared/ui/on_failure.webp'>Back to layout</button>
                            </div>
                            <div class="targetChange"></div>
                            <div class="options flex flex-end gap"></div>
                            <div id="simulatorConditionLayout">
                                <label>Conditions configuration</label>
                                <div id="simulatorConditionRequirements" class="requirements"></div>
                            </div>
                        </div>
