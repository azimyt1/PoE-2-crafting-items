                                <div id="simulatorSimulationResults" class="flex-grow"></div>
                            </div>
                        </div>
                        <div id="simulatorStepEditor" class="simulatorBlock hidden flex flex-columns">
                            <div class="simulatorTitle">Step edition</div>
                            <div class="header flex align-center gap">
                                <button onClick="Simulator.removeStep()">Remove</button>
                                <button onClick="Simulator.copyStep()">Copy</button>
                                <div class="titleHolder flex-grow"></div>
                                <button onClick="Simulator.saveStep()"><img src='assets/shared/ui/on_success.webp'>Apply changes</button>
