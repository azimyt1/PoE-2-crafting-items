                    <div class="operationsHolder flex-grow hidden">
                        <div id="simulatorLoadInterface" class="simulatorBlock operation hidden">
                            <div class="simulatorTitle">Simulations inventory</div>
                            <div class="header flex align-center gap">
                                <div class="flex-grow"></div>
                                <button onClick="Simulator.importData('data')">Import all</button>
                                <button onClick="Simulator.exportData()">Export all</button>
                                <button onClick="Simulator.backToSimulator()"><img src='assets/shared/ui/on_failure.webp'>Back to layout</button>
