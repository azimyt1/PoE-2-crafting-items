                                        <div class="label flex-grow">Time elapsed</div>
                                        <div id="simulatorStatTimeElapsed" class="simulatorStat"></div>
                                    </div>
                                    <div id="simulatorProcessorOuput" class="processorOutput flex flex-columns gap-mini"></div>
