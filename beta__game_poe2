                        <div class="flex gap flex-wrap">
                            <button id="startFossilOptimizerButton" class="game button green" onClick="fossilOptimizer.run()">Run Fossil Optimizer</button>
                            <button id="stopFossilOptimizerButton" class="game button red hidden" onClick="fossilOptimizer.stop()">Stop Fossil Optimizer</button>
