                        <div class='full-width'>Cost efficiency</div>
                        <div class="text-center">Chance</div>
                        <div class="text-center">Tries</div>
                        <div class="text-center">Costs</div>
                    </div>
                </div>
            </div>
        </template>

        <dialog id="inventoryDialog" class="over-shadow"></dialog>
    
