function parseEssenceForImage(essence) {
    essence = essence.toLowerCase();
    essence = essence.replace(/ /g, "_");
    essence = essence.replace(/'/g, "");
    essence = essence.replace("_essence_of_the", "");
    essence = essence.replace("_essence_of", "");
    essence = essence.replace("essence_of_the_", "essence_");
    essence = essence.replace("essence_of_", "essence_");
    return essence;
}

/* Emulator socketable item description */
function buildSocketableModDescription(socketable) {
    let mods = JSON.parse(socketable.mods);
    let desc = "";
    let byMod = {};
    $.each(socketable_title_by_type, function (key, label) {
        if (mods[key]) {
            if (Array.isArray(mods[key])) {
                $.each(mods[key], function (index, entry) {
                    if (entry.mod && poecd.modifiers.ind[entry.mod] && poecd.modifiers.seq[poecd.modifiers.ind[entry.mod]]) {
                        let mod = poecd.modifiers.seq[poecd.modifiers.ind[entry.mod]];
                        let modName = mod.name_modifier.replace(/\\n/, "<br>");
                        if (byMod[modName] == undefined) byMod[modName] = [];
                        if (entry.bgroup) {
                            byMod[modName].push(poecl.bgroup[entry.bgroup]);
                            //desc += "<div><div class='mmit'>" + poecl.bgroup[entry.bgroup] + "</div>" + mod.name_modifier.replace(/\\n/, "<br>") + "</div>";
                        } else {
                            $.each(entry.bases, function (baseIndex, baseId) {
                                byMod[modName].push(poecl.base[baseId]);
                                //desc += "<div><div class='mmit'>" + poecl.base[baseId] + "</div>" + mod.name_modifier.replace(/\\n/, "<br>") + "</div>";
                            });
                        }
                    }
                });
            } else {
                if (poecd.modifiers.ind[mods[key]] && poecd.modifiers.seq[poecd.modifiers.ind[mods[key]]]) {
                    let mod = poecd.modifiers.seq[poecd.modifiers.ind[mods[key]]];
                    let modName = mod.name_modifier.replace(/\\n/, "<br>");
                    if (byMod[modName] == undefined) byMod[modName] = [];
                    byMod[modName].push(label);
                    //desc += "<div><div class='mmit'>" + label + "</div>" + mod.name_modifier.replace(/\\n/, "<br>") + "</div>";
                }
            }
        }
    });
    $.each(byMod, function (modName, bases) {
        desc += "<div><div class='mmit'>" + bases.join(", ") + "</div>" + modName + "</div>";
    });
    return desc;
}

class poe2Item {
    #raw = null;
    #blocks = null;
    #rarity = null;
    #base = null;
    #level = null;
    #corrupted = null;
    #requirements = null;
    #runes = null;
    #socketed = [];
    #sockets = null;
    #affixes = null;
    #note = null;
    #implicits = null;
    #quality = null;
    #baseItemId = null;
    #baseId = null;
    #unrevealed = [];
    #fractured = {};
    #desecrated = {};
    #built = {};
    #values = {};
    #modifiers = [];
    #errors = [];

    constructor(paste = null) {
        this.#raw = paste;
        if (paste) {
            this.parseItemPaste();
        }
    }

    get errors() {
        return this.#errors;
    }

    get sockets() {
        return this.#sockets;
    }

    get implicits() {
        return this.#implicits;
    }

    get quality() {
        return this.#quality;
    }

    get values() {
        return this.#values;
    }

    get level() {
        return this.#level;
    }

    get baseItemId() {
        return this.#baseItemId;
    }

    get baseId() {
        return this.#baseId;
    }

    get socketed() {
        return this.#socketed;
    }

    get fractured() {
        return this.#fractured;
    }

    get built() {
        return this.#built;
    }

    get modifiers() {
        return this.#modifiers;
    }

    get unrevealed() {
        return this.#unrevealed;
    }

    get desecrated() {
        return this.#desecrated;
    }

    get rarity() {
        return this.#rarity.toLowerCase();
    }

    get corrupted() {
        return (this.#corrupted) ? 1 : 0;
    }

    set raw(paste = null) {
        this.#raw = paste;
    }

    set blocks(blocks) {
        this.#blocks = blocks;
    }

    parseBlock(block) {
        let blockLines = poec_removeArrEmpty(block.split("\n"));
        let thisObject = this;

        // Check for corruption
        if (this.#corrupted == null) {
            $.each(blockLines, function (lineIndex, lineData) {
                if (lineData == "Corrupted") {
                    thisObject.#corrupted = true;
                    return;
                }
            });
        }

        // Requirements
        if (this.#requirements == null && (block.indexOf("Requirements:") > -1 || block.indexOf("Requires:") > -1)) {
            this.#requirements = this.parseRequirements(block);
            return;
        }

        // Runes
        if (this.#runes == null && block.indexOf("(rune)") > -1) {
            this.#runes = blockLines;
            return;
        }

        // Sockets
        if (this.#sockets == null && block.indexOf("Sockets:") > -1) {
            let socketInfo = block.split(":");
            this.#sockets = socketInfo[1].split("S").length - 1;
            return;
        }

        // Item level
        if (this.#level == null && block.indexOf("Item Level:") > -1) {
            let itemLevel = block.split(":");
            this.#level = parseInt(itemLevel[1].trim());
            return;
        }

        // Affixes
        if (this.#affixes == null && (block.indexOf("Suffix Modifier") > -1 || block.indexOf("Prefix Modifier") > -1)) {
            this.#affixes = this.parseAffixes(blockLines);
            return;
        }

        // Note
        if (this.#note == null && block.indexOf("Note:") > -1) {
            let note = block.split(":");
            this.#note = note[1];
            return;
        }

        // Quality
        if (this.#quality == null && block.indexOf("Quality:") > -1) {
            $.each(blockLines, function (index, line) {
                if (line.indexOf("Quality:") > -1) {
                    var matches = line.match(/([0-9]+)/gm);
                    thisObject.#quality = parseInt(matches[0]);
                }
            });
            return;
        }

        // Implicits
        if (this.#implicits == null && (block.indexOf("Implicit Modifier") > -1 || block.indexOf("(implicit)") > -1)) {
            this.#implicits = blockLines;
            return;
        }
    }

    parseItemPaste(paste = null) {
        if (paste) this.raw = raw(paste);
        this.blocks = (this.#raw.split("--------"));

        // Base data is always first block
        let baseData = poec_removeArrEmpty(this.#blocks[0].split("\n"));

        // Rarity
        let thisObject = this;
        $.each(baseData, function (lineIndex, line) {
            if (line.indexOf("Rarity:") > -1) {
                thisObject.#rarity = line.split(":");
                thisObject.#rarity = thisObject.#rarity[1].trim();
            }
        });
        if (!this.#rarity) {
            this.#rarity = baseData[1].split(":");
            this.#rarity = this.#rarity[1].trim();
        }

        // Base info
        let baseLines = baseData.length;
        let nameLine = (baseLines == 3) ? 2 : 3;
        this.#base = baseData[nameLine].trim();

        // Parse blocks
        for (var blockIndex = 1; blockIndex < this.#blocks.length; blockIndex++) {
            this.parseBlock(this.#blocks[blockIndex]);
        }

        // Parse base
        this.parseBase();

        // Parse modifiers
        this.parseModifiers();

        // Parse runes
        this.parseSocketables();
    }

    findBaseByName() {
        if (poecd["bitems"]["name"][this.#base]) {
            return poecd["bitems"]["name"][this.#base];
        }

        if (poecd["bitems"]["name"][this.#base] == undefined && this.#rarity == "Normal") {
            this.#base = this.#base.replace("Superior ", "");
            return poecd["bitems"]["name"][this.#base];
        }

        if (poecd["bitems"]["name"][this.#base] == undefined && this.#rarity == "Magic") {
            if (this.#base.indexOf(" of ") > -1) {
                // Magic suffix
                this.#base = this.#base.split(" of ");
                this.#base = this.#base[0].trim();
            }

            if (poecd["bitems"]["name"][this.#base] == undefined) {
                // Remove first word and retry (magic prefix)
                var words = this.#base.split(" ");
                this.#base = this.#base.replace(words[0] + " ", "");
            }

            if (poecd["bitems"]["name"][this.#base] == undefined) {
                // Remove second word and retry (magic prefix)
                var words = this.#base.split(" ");
                this.#base = this.#base.replace(words[0] + " ", "");
            }

            return poecd["bitems"]["name"][this.#base];
        }

        return null;
    }

    parseBase() {
        if (this.#rarity == "Unique") {
            return;
        }

        let baseItemId = this.findBaseByName();

        if (baseItemId == null) {
            return;
        }

        let useBase = poecd["bitems"]["name"][this.#base];

        if (Array.isArray(useBase)) {
            // Base has multiple name matches, compare requirements
            var checking = [];
            if (this.#requirements.intelligence) {
                checking.push({ "what": "intelligence", "with": this.#requirements.intelligence });
            }
            if (this.#requirements.strength) {
                checking.push({ "what": "strength", "with": this.#requirements.strength });
            }
            if (this.#requirements.dexterity) {
                checking.push({ "what": "strength", "with": this.#requirements.strength });
            }

            let foundbase = null;
            $.each(useBase, function (index, baseId) {
                let baseDetails = poecd["bitems"]["seq"][baseId];
                let requirements = JSON.parse(baseDetails["requirements"]);
                let checks = 0;
                $.each(checking, function (checkIndex, checkDetails) {
                    $.each(requirements, function (checkWhat, checkWith) {
                        if (checkDetails["what"] == checkWhat && checkDetails["with"] == checkWith) {
                            checks++;
                        }
                    });
                });
                if (checks >= checking.length) {
                    foundBase = baseId;
                    return;
                }
            });

            if (foundbase) {
                useBase = foundBase;
            } else {
                // Could not figure out base, use first
                useBase = useBase[0];
            }
        }

        // Set base item
        var baseData = poecd["bitems"]["seq"][useBase];
        this.#baseItemId = parseInt(baseData["id_bitem"]);
        this.#baseId = parseInt(baseData["id_base"]);
    }

    parseAffixes(lines) {
        let affixes = [];
        let currentAffix = -1;
        $.each(lines, function (index, line) {
            if (line[0] == "{") {
                // New affix
                currentAffix++;
                affixes.push({
                    "advancedLine": line,
                    "modifierName": null,
                    "invertedModifierName": null,
                    "fractured": false,
                    "desecrated": false
                });
            } else {
                // Affix details
                if (line.indexOf("(fractured)") > -1) {
                    affixes[currentAffix]["fractured"] = true;
                }
                if (line.indexOf("(desecrated)") > -1) {
                    affixes[currentAffix]["desecrated"] = true;
                }
                // Filter out stuff
                var modifierName = line.replace(" — Unscalable Value", "").trim();
                modifierName = line.replace(" (fractured)", "").trim();
                modifierName = line.replace(" (desecrated)", "").trim();
                // Build hybrids
                if (affixes[currentAffix]["modifierName"] == null) {
                    affixes[currentAffix]["modifierName"] = modifierName;
                    affixes[currentAffix]["invertedModifierName"] = modifierName;
                } else {
                    affixes[currentAffix]["modifierName"] += ", " + modifierName;
                    affixes[currentAffix]["invertedModifierName"] = modifierName + ", " + affixes[currentAffix]["invertedModifierName"];
                }
            }
        });

        // Clean out invalid things
        var cleanedAffixes = [];
        $.each(affixes, function (index, affix) {
            if (affix.advancedLine != "{ Unique Modifier }") {
                cleanedAffixes.push(affix);
            }
        });

        return cleanedAffixes;
    }

    parseRequirements(text) {
        let splitData = text.split(":");
        let information = splitData[1].split(", ");

        let requirements = { "level": null, "intelligence": null, "dexterity": null, "strength": null };
        $.each(information, function (index, data) {
            if (data.indexOf("Level") > -1) {
                requirements.level = parseInt(data.replace("Level ", ""));
                return;
            }
            data = data.replace("(augmented) ", "");
            splitData = data.split(" ");
            let value = parseInt(splitData[0]);
            if (splitData[1].indexOf("Int") > -1) {
                requirements.intelligence = value;
                return;
            }
            if (splitData[1].indexOf("Str") > -1) {
                requirements.strength = value;
                return;
            }
            if (splitData[1].indexOf("Dex") > -1) {
                requirements.dexterity = value;
                return;
            }
        });

        return requirements;
    }

    parseModifiers() {
        var rrep = /\((\S*)\)/gm;
        var vrep = / ,/gm;

        let thisObject = this;

        $.each(this.#affixes, function (index, affix) {
            let modifier = {
                "atype": null,
                "mgrp": 1,
                "notable": false,
                "id": null,
                "tier": null
            };

            let matches = affix.advancedLine.match(/"(.*)"/gm);
            if (matches) {
                switch (matches[0].replace(/"/g, "")) {
                    case 'of Kurgal': case 'Kurgal\'s': modifier.mgrp = 10; break;
                    case 'of Amanamu': case 'Amanamu\'s': modifier.mgrp = 10; break;
                    case 'of Ulaman': case 'Ulaman\'s': modifier.mgrp = 10; break;
                    case 'of the Essence': case 'Essences': modifier.mgrp = 13; break;
                    default: break;
                }
            }

            modifier.atype = (affix.advancedLine.indexOf("Prefix Modifier") > -1) ? "prefix" : "suffix";

            let modifierName = affix.modifierName.replace(rrep, "").replace(vrep, ",").trim();
            let invertedModifierName = affix.invertedModifierName.replace(rrep, "").replace(vrep, ",").trim();

            let parsedName = modifierName;
            let modifierValues = [];
            let invertedParsedName = invertedModifierName;
            let invertedModifierValues = [];
            if (!modifier.notable) {
                parsedName = modifierName.replace(/([0-9.]+)/g, "#").replace(/-#/g, "#");
                modifierValues = modifierName.match(/(-?[0-9.]+)/g, "#");
                invertedParsedName = invertedModifierName.replace(/([0-9.]+)/g, "#").replace(/-#/g, "#");
                invertedModifierValues = invertedModifierName.match(/(-?[0-9.]+)/g, "#");
            }

            if (affix.modifierName == "Desecrated Suffix" || affix.modifierName == "Desecrated Prefix") {
                thisObject.#unrevealed.push((affix.modifierName == "Desecrated Suffix") ? "suffix" : "prefix");
                return;
            }

            let affixMatches = [];

            // Built tri+ part check
            let parts = parsedName.split(", ");
            let multiPartName = null;
            let multiPartValues = null;
            if (parts.length > 2) {
                // TODO : refactor to try all permutations
                multiPartName = [parts[parts.length - 1]];
                multiPartValues = [modifierValues[modifierValues.length - 1]];
                for (let i = 0; i < parts.length - 1; i++) {
                    multiPartName.push(parts[i]);
                    multiPartValues.push(modifierValues[i]);
                }
                multiPartName = multiPartName.join(", ");
            }

            // Find mod in base mods
            $.each(poecd['basemods'][thisObject.#baseId], function (index, baseModId) {
                let modDetails = poecd['modifiers']['seq'][poecd['modifiers']['ind'][baseModId]];
                let modName = modDetails['name_modifier'];

                // Change values to # for modifier name
                if (!modifier.notable) {
                    modName = modName.replace(/([0-9.]+)/g, "#");
                }

                // Match modifier name and type
                if ((modName == parsedName || modName == invertedParsedName || (multiPartName !== null && modName == multiPartName)) && modDetails.affix == modifier.atype) {
                    let affixMatch = { "id": baseModId, "tier": null, "values": null };

                    // Which values are we taking
                    let takeValues = invertedModifierValues;
                    if (modName == parsedName) {
                        takeValues = modifierValues;
                    }
                    if (multiPartName !== null && modName == multiPartName) {
                        takeValues = multiPartValues;
                    }

                    // Find tier match
                    let tierMatchIndex = null;
                    $.each(poecd['tiers'][baseModId][thisObject.#baseId], function (tierIndex, tierDetails) {
                        let tierValues = JSON.parse(tierDetails.nvalues);

                        var tierMatch = true;
                        $.each(tierValues, function (valuesIndex, values) {
                            let affixValue = parseFloat(takeValues[valuesIndex]);
                            let valuesMatch = false;
                            if (Array.isArray(values)) {
                                if (affixValue >= parseFloat(values[0]) && affixValue <= parseFloat(values[1])) {
                                    valuesMatch = true;
                                }
                            } else {
                                if (affixValue == parseFloat(values)) {
                                    valuesMatch = true;
                                }
                            }
                            if (!valuesMatch) {
                                tierMatch = false;
                            }
                        });

                        if (tierMatch) {
                            // Tier matches
                            tierMatchIndex = tierIndex;
                            return;
                        }
                    });

                    if (tierMatchIndex !== null) {
                        affixMatch.tier = tierMatchIndex;
                        affixMatch.values = takeValues;
                    }

                    affixMatches.push(affixMatch);
                }
            });

            if (affixMatches.length == 0) {
                // Could not find affix
                thisObject.#errors.push("Could not find a valid affix for : \"" + parsedName + "\"\n(Might be a legacy modifier)\n");
                return;
            }

            let useAffix = null;
            if (affixMatches.length > 1) {
                let numberOfValidAffixes = 0;
                let useAffixIndex = -1;
                let firstValidAffix = -1;
                $.each(affixMatches, function (affixMatchIndex, affixMatch) {
                    if (affixMatch.tier !== null) {
                        useAffixIndex = affixMatchIndex;
                        numberOfValidAffixes++
                        if (firstValidAffix < 0) {
                            firstValidAffix = affixMatchIndex;
                        }
                    }
                });
                if (numberOfValidAffixes == 0) {
                    thisObject.#errors.push("Could not find a matching tier for any matching affix : \"" + parsedName + "\"\n");
                    return;
                }
                if (numberOfValidAffixes > 1) {
                    // Multiple matches, use first
                    affixMatches = [affixMatches[firstValidAffix]];
                } else {
                    // Only one match
                    affixMatches = [affixMatches[useAffixIndex]];
                }
            }

            useAffix = affixMatches[0];

            if (useAffix.tier == null) {
                thisObject.#errors.push("Could not find a matching tier for matching affix for : \"" + parsedName + "\"\n");
                return;
            }

            modifier.id = useAffix.id;
            modifier.tier = useAffix.tier;

            if (affix.desecrated) {
                modifier.mgrp = 10;
                thisObject.desecrated[modifier.id] = true;
            }

            thisObject.built[modifier.id] = (modifier.tier > -1) ? poecd['tiers'][modifier.id][thisObject.#baseId][modifier.tier]["ilvl"] : -1;

            if (affix.fractured) {
                thisObject.fractured[modifier.id] = true;
            }

            $.each(useAffix.values, function (valueIndex, value) {
                useAffix.values[valueIndex] = parseFloat(useAffix.values[valueIndex]);
            });

            thisObject.#values[modifier.id] = useAffix.values;
            thisObject.#modifiers.push(modifier);
        });
    }

    getBaseRuneType(baseId) {
        for (let i = 0; i < poecd.socketables.bybase.armour.length; i++) {
            if (poecd.socketables.bybase.armour[i] == baseId) {
                return "armour";
            }
        }

        for (let i = 0; i < poecd.socketables.bybase.weapons.length; i++) {
            if (poecd.socketables.bybase.weapons[i] == baseId) {
                return "weapons";
            }
        }

        for (let i = 0; i < poecd.socketables.bybase.caster.length; i++) {
            if (poecd.socketables.bybase.caster[i] == baseId) {
                return "caster";
            }
        }

        return null;
    }

    getRuneType(socketable) {
        if (socketable.stype == "rune") {
            return "runes";
        }

        if (socketable.stype == "soulcore") {
            return "cores";
        }

        return "talisman";
    }

    findCombinations(numbers, target, maxNumbersUsed) {
        const results = [];

        function backtrack(index, currentCounts, currentSum, totalUsed) {
            if (currentSum === target && totalUsed <= maxNumbersUsed) {
                results.push({ ...currentCounts });
                return;
            }

            if (currentSum > target || index >= numbers.length || totalUsed > maxNumbersUsed) {
                return;
            }

            const num = numbers[index];
            const maxCount = Math.floor((target - currentSum) / num);

            for (let count = 0; count <= maxCount; count++) {
                const newTotalUsed = totalUsed + count;
                if (newTotalUsed > maxNumbersUsed) break;

                currentCounts[num] = count;
                backtrack(index + 1, currentCounts, currentSum + count * num, newTotalUsed);
            }

            delete currentCounts[num]; // Clean up for backtracking
        }

        backtrack(0, {}, 0, 0);
        return results;
    }

    parseSocketables() {
        if (this.#runes) {
            let baseRuneType = this.getBaseRuneType(new String(this.#baseId));
            if (baseRuneType) {
                let runesData = {};
                let rreg = /([0-9.]+)/gm;
                let thisObject = this;
                $.each(this.#runes, function (runeIndex, rune) {
                    rune = rune.replace("(rune)", "").trim();
                    if (rune) {
                        let m;
                        let values = [];
                        while ((m = rreg.exec(rune)) !== null) {
                            // This is necessary to avoid infinite loops with zero-width matches
                            if (m.index === rreg.lastIndex) {
                                regex.lastIndex++;
                            }

                            values.push(parseFloat(m[0]));
                        }

                        let affixName = rune.replace(rreg, "#").replace(/\-/g, "");

                        // Cycle runes to find match for affix
                        $.each(poecd.socketables.seq, function (socketIndex, socketable) {
                            let socketMods = JSON.parse(socketable.mods);
                            let modId = socketMods[baseRuneType];

                            if (!modId && socketMods.all) {
                                modId = socketMods.all;
                            }

                            if (!modId && socketMods.class) {
                                $.each(socketMods.class, function (classIndex, classes) {
                                    $.each(classes.bases, function (classBaseIndex, classBase) {
                                        if (classBase == thisObject.#baseId) {
                                            modId = classBase.mod;
                                        }
                                    });
                                });
                            }

                            if (modId) {
                                let socketMod = poecd.modifiers.seq[poecd.modifiers.ind[modId]];
                                if (socketMod) {
                                    if (socketMod.name_modifier == affixName) {
                                        if (!runesData[affixName]) runesData[affixName] = [];
                                        // Affix matches 
                                        runesData[affixName].push({
                                            "socketable": socketable.id_socketable,
                                            "type": thisObject.getRuneType(socketable),
                                            "currentValues": values,
                                            "socketValues": JSON.parse(poecd.tiers[modId][thisObject.#baseId][0].nvalues)
                                        });
                                    }
                                }
                            }
                        });
                    }
                });

                $.each(runesData, function (affixName, runes) {
                    let total = 0;
                    $.each(runes[0].currentValues, function (valueIndex, value) {
                        total += value;
                    });
                    let numbers = [];
                    $.each(runes, function (runeIndex, runeData) {
                        let number = 0;
                        $.each(runeData.socketValues, function (valueIndex, value) {
                            number += value;
                        });
                        numbers.push(number);
                    });
                    let combinations = thisObject.findCombinations(numbers, total, thisObject.#sockets);
                    if (combinations.length == 0) {
                        // Could not find any combinations for socketable
                        thisObject.#errors.push("Could not find any combination for socketable : \"" + affixName + "\"\n");
                        return;
                    }
                    let combination = combinations[0];
                    $.each(combination, function (number, amount) {
                        $.each(runes, function (runeIndex, runeData) {
                            let total = 0;
                            $.each(runeData.socketValues, function (valueIndex, value) {
                                total += value;
                            });
                            if (number == total) {
                                for (let count = 0; count < amount; count++) {
                                    thisObject.#socketed.push({
                                        "id": parseInt(runeData.socketable),
                                        "type": runeData.type
                                    });
                                }
                            }
                        });
                    });
                });
            }
        }
    }
}

function poec_importItemPOE2(ditem, mode) {
    if (ditem.indexOf("--------") > -1) {
        try {
            var item = new poe2Item(ditem);
            //console.log(item);

            if (item.rarity == "Unique") {
                poec_storedImportInfo = $("#poecItemImportText").val();
                $("#poecItemImportText").val("Can't import unique item!").addClass("error");
                return;
            }

            if (item.baseItemId == null) {
                poec_storedImportInfo = $("#poecItemImportText").val();
                $("#poecItemImportText").val("Can't find item base!").addClass("error");
                return;
            }

            poec_itemImportParams["sockets"] = item.sockets ?? 0;
            poec_itemImportParams["implicits"] = item.implicits ?? null;
            poec_itemImportParams["quality"] = item.quality ?? null;
            poec_itemImportParams["ilvl"] = item.level ?? null;
            poec_itemImportParams["bitem"] = item.baseItemId;
            poec_itemImportParams["base"] = item.baseId;
            poec_itemImportParams["influences"] = null;
            poec_itemImportParams["rarity"] = item.rarity;
            poec_itemImportParams["socketed"] = item.socketed;
            poec_itemImportParams["corrupted"] = item.corrupted;
            poec_itemImportParams["veils"] = item.unrevealed;
            poec_itemImportParams["fracs"] = item.fractured;
            poec_itemImportParams["build"] = item.built;
            poec_itemImportParams["values"] = item.values;
            poec_itemImportParams["desecrated"] = item.desecrated;
            poec_itemImportParams["bimps"] = {};

            //console.log(poec_itemImportParams);

            // Switch method via rarity of item
            switch (item.rarity) {
                case 'normal':
                    if (poec_cMethod != "alteration" && poec_cMethod != "transmute" && poec_cMethod != "alchemy") {
                        poec_itemImportParams["method"] = "alteration";
                    }
                    break;
                case 'magic':
                    if (poec_cMethod != "augmentation" && poec_cMethod != "regal") {
                        poec_itemImportParams["method"] = "regal";
                    }
                    break;
                default:
                    if (poec_cMethod != "exalted") {
                        poec_itemImportParams["method"] = "exalted";
                    }
                    break;
            }

            //console.log(poec_itemImportParams);

            if (item.errors.length == 0 || mode == "external") {
                poec_importItemProceed();
                return;
            }

            poec_storedImportInfo = $("#poecItemImportText").val();
            $("#poecItemImportText").val(item.errors.length + " anomalie(s)!\n\nClick import again to proceed regardless.\n\n" + item.errors.join("\n")).addClass("anomalies");
        } catch (err) {
            poec_storedImportInfo = $("#poecItemImportText").val();
            console.log(err);
            $("#poecItemImportText").val("AN ERROR OCCURED!\n\nMake SURE you used the ALT+CTRL+C function. (advanced mod descriptions NEED to be enabled in the ui options)\n\nIf this persists please let me know by sending me an e-mail at dev@craftofexile.com with the item data so i can investigate.").addClass("error");
        }
    } else {
        poec_storedImportInfo = $("#poecItemImportText").val();
        $("#poecItemImportText").val("Bad item format!").addClass("error");
    }
}

function updateSelectedOmens() {
    let omens = "";
    crsimCurrentActiveOmens = [];
    $("#crsimActSub_poe2_omens").find(".sel").each(function () {
        crsimCurrentActiveOmens.push($(this).attr("scode"));
        omens += "<div><div>" + $(this).find(".icon").html() + "</div><div>Omen of " + $(this).text() + "</div></div>";
    });
    if (omens != "") {
        if ($("#crsimActiveOmens").length == 0) {
            $("<div>").attr("id", "crsimActiveOmens").appendTo($("#crsimOptions"));
        }
        $("#crsimActiveOmens").html("<div class='label'>Active Omens</div><div class='omens'>" + omens + "</div>");
    } else {
        $("#crsimActiveOmens").remove();
    }
}

function selectOmens(omens) {
    $.each(omens, function (key, omen) {
        $("#crsimActSub_poe2_omens").find(".acs_poe2_omens" + omen).addClass("sel");
    });
    updateSelectedOmens();
}

function consumeOmens(omens, override) {
    if (!omens) return null;

    let spentOmens = [];
    $.each(omens, function (key, omen) {
        if (crsimCurrentActiveOmens.includes(omen)) {
            spentOmens.push(omen);
        }
        crsimCurrentActiveOmens = crsimCurrentActiveOmens.filter(e => e !== omen);
        if (!override) {
            $("#crsimActSub_poe2_omens").find(".acs_poe2_omens" + omen).removeClass("sel");
        }
    });

    if (!override) {
        spendOmens(spentOmens);
        updateSelectedOmens();
    }

    return spentOmens;
}

function spendOmens(omens) {
    $.each(omens, function (key, omen) {
        poec_simUpdateSpending("actions", "poe2_omens", 1, null, omen);
    });
}

function checkOmensForMethod(method) {
    if (omensForMethods[method]) {
        let hasOmen = false;
        $.each(omensForMethods[method], function (key, omen) {
            if (crsimCurrentActiveOmens.includes(omen)) {
                hasOmen = true;
            }
        });
        return hasOmen;
    }
    return false;
}

function checkForActiveOmen(omen) {
    if (crsimCurrentActiveOmens.includes(omen)) {
        return true;
    }
    return false;
}

function throwOmenError(override) {
    let errors = "This combination of Omens is not valid";
    if (!override) {
        $("#simItemHoverer").mcuiNotice({ text: errors, type: "alert" }).showNotice();
        $("#simItemHoverer").mcuiNotice().setText(errors);
    } else {
        poec_simThrowError(errors);
    }
}

function obtainHomogenisationTags(affixes) {
    let tags = [];
    $.each(affixes, function (key, affix) {
        let mod = poecd["modifiers"]["seq"][poecd["modifiers"]["ind"][affix.id]];
        if (mod.mtypes) {
            let affixTags = mod.mtypes;
            affixTags = (affixTags.replace(/^\|+|\|+$/g, '')).split("|");
            $.each(affixTags, function (tagKey, tag) {
                tag = parseInt(tag);
                if (!tags.includes(tag) && !crsim_ignhomotypes.includes(tag)) {
                    tags.push(tag);
                }
            });
        }
    });
    if (tags.length == 0) {
        return null;
    }
    return tags;
}

function poec_selectOmen(button) {
    let omen = $(button).attr("omen");

    if (poec_cOmens == null) {
        poec_cOmens = [];
    } else {
        poec_cOmens = poec_cOmens.split("|");
    }

    if ($(button).hasClass("selected")) {
        $(button).removeClass("selected");
        if (poec_cOmens.includes(omen)) {
            poec_cOmens = poec_cOmens.filter(e => e !== omen);
        }
    } else {
        $(button).addClass("selected");
        if (!poec_cOmens.includes(omen)) {
            poec_cOmens.push(omen);
        }
    }

    if (poec_cOmens.length == 0) {
        poec_cOmens = null;
    } else {
        poec_cOmens = poec_cOmens.join("|");
    }

    poec_updateOmenEffect();
    poec_buildShareLink(false);
    poec_refreshAffixes(false);
}

function poec_updateOmenEffect() {
    // Filter omens for method
    if (poec_cOmens == null) {
        poec_cOmens = [];
    } else {
        poec_cOmens = poec_cOmens.split("|");
    }

    let filteredOmens = [];
    $.each(poec_cOmens, function (key, omen) {
        if (omensForMethods[poec_cMethod].includes(omen)) {
            filteredOmens.push(omen);
        }
    });

    if (filteredOmens.length == 0) {
        poec_cOmens = null;
    } else {
        poec_cOmens = filteredOmens.join("|");
    }

    let prefixOnly = false;
    let suffixOnly = false;
    poec_omenEffect = null;

    let fullOmens = "|" + poec_cOmens + "|";

    if (fullOmens.indexOf("|dextral_annulment|") > -1
        || fullOmens.indexOf("|dextral_coronation|") > -1
        || fullOmens.indexOf("|dextral_exaltation|") > -1) {
        poec_omenEffect = "prefix";
        prefixOnly = true;
    }

    if (fullOmens.indexOf("|sinistral_annulment|") > -1
        || fullOmens.indexOf("|sinistral_coronation|") > -1
        || fullOmens.indexOf("|sinistral_exaltation|") > -1) {
        poec_omenEffect = "suffix";
        suffixOnly = true;
    }

    poec_omenHomogenise = false;
    if (fullOmens.indexOf("|homogenising_coronation|") > -1
        || fullOmens.indexOf("|homogenising_exaltation|") > -1) {
        poec_omenHomogenise = true;
    }

    if (prefixOnly && suffixOnly) {
        poec_omenEffect = null;
    }
}

function filterSimulatorTieredCurrencySubAction(subAction) {
    if (subAction == null || typeof subAction !== 'string') return subAction;
    subAction = subAction.replace(/^transmute_|regal_|augmentation_|chaos_|exalted_/, "");
    return subAction;
}