044c\u044f \u0432 \u0432\u0438\u0434\u0435 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u044d\u043d\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0449\u0438\u0442\u0430, #% \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u043f\u0443\u0442\u0435\u0432\u044b\u0445 \u043a\u0430\u043c\u043d\u0435\u0439, \u043d\u0430\u0445\u043e\u0434\u0438\u043c\u044b\u0445 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438","5398":"\u041c\u043e\u043d\u0441\u0442\u0440\u044b \u0441 #% \u0448\u0430\u043d\u0441\u043e\u043c \u043c\u043e\u0433\u0443\u0442 \u043d\u0430\u043b\u043e\u0436\u0438\u0442\u044c \u043a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u043f\u0440\u0438 \u043d\u0430\u043d\u0435\u0441\u0435\u043d\u0438\u0438 \u0443\u0434\u0430\u0440\u0430, #% \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u043f\u0443\u0442\u0435\u0432\u044b\u0445 \u043a\u0430\u043c\u043d\u0435\u0439, \u043d\u0430\u0445\u043e\u0434\u0438\u043c\u044b\u0445 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438","5407":"\u041c\u043e\u043d\u0441\u0442\u0440\u044b \u0441 #% \u0448\u0430\u043d\u0441\u043e\u043c \u043c\u043e\u0433\u0443\u0442 \u043d\u0430\u043b\u043e\u0436\u0438\u0442\u044c \u043e\u0442\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043f\u0440\u0438 \u043d\u0430\u043d\u0435\u0441\u0435\u043d\u0438\u0438 \u0443\u0434\u0430\u0440\u0430, #% \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u043f\u0443\u0442\u0435\u0432\u044b\u0445 \u043a\u0430\u043c\u043d\u0435\u0439, \u043d\u0430\u0445\u043e\u0434\u0438\u043c\u044b\u0445 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438","5414":"\u041c\u043e\u043d\u0441\u0442\u0440\u044b \u0438\u043c\u0435\u044e\u0442 #% \u0448\u0430\u043d\u0441 \u043f\u043e\u0445\u0438\u0449\u0430\u0442\u044c \u0437\u0430\u0440\u044f\u0434\u044b \u044d\u043d\u0435\u0440\u0433\u0438\u0438, \u044f\u0440\u043e\u0441\u0442\u0438 \u0438 \u0432\u044b\u043d\u043e\u0441\u043b\u0438\u0432\u043e\u0441\u0442\u0438 \u043f\u0440\u0438 \u043d\u0430\u043d\u0435\u0441\u0435\u043d\u0438\u0438 \u0443\u0434\u0430\u0440\u0430, #% \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u043f\u0443\u0442\u0435\u0432\u044b\u0445 \u043a\u0430\u043c\u043d\u0435\u0439, \u043d\u0430\u0445\u043e\u0434\u0438\u043c\u044b\u0445 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438","5400":"\u041c\u0435\u0442\u043a\u043e\u0441\u0442\u044c \u043c\u043e\u043d\u0441\u0442\u0440\u043e\u0432 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0430 \u043d\u0430 #%, #% \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u043f\u0443\u0442\u0435\u0432\u044b\u0445 \u043a\u0430\u043c\u043d\u0435\u0439, \u043d\u0430\u0445\u043e\u0434\u0438\u043c\u044b\u0445 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438","5397":"\u041c\u043e\u043d\u0441\u0442\u0440\u044b \u0438\u043c\u0435\u044e\u0442 #% \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f, #% \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u043f\u0443\u0442\u0435\u0432\u044b\u0445 \u043a\u0430\u043c\u043d\u0435\u0439, \u043d\u0430\u0445\u043e\u0434\u0438\u043c\u044b\u0445 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438","5406":"\u041c\u043e\u043d\u0441\u0442\u0440\u044b \u0438\u043c\u0435\u044e\u0442 #% \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0448\u0430\u043d\u0441\u0430 \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0443\u0434\u0430\u0440\u0430, +#% \u043a \u043c\u043d\u043e\u0436\u0438\u0442\u0435\u043b\u044e \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0443\u0434\u0430\u0440\u0430 \u043c\u043e\u043d\u0441\u0442\u0440\u043e\u0432, #% \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u043f\u0443\u0442\u0435\u0432\u044b\u0445 \u043a\u0430\u043c\u043d\u0435\u0439, \u043d\u0430\u0445\u043e\u0434\u0438\u043c\u044b\u0445 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438","5405":"\u041c\u043e\u043d\u0441\u0442\u0440\u044b \u0438\u043c\u0435\u044e\u0442 #% \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u0448\u0430\u043d\u0441\u0430 \u043d\u0430\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u043f\u043e\u0434\u0436\u043e\u0433\u0430, \u041c\u043e\u043d\u0441\u0442\u0440\u044b \u0438\u043c\u0435\u044e\u0442 #% \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043d\u0430\u043a\u043e\u043f\u043b\u0435\u043d\u0438\u044f \u0448\u043a\u0430\u043b\u044b \u0437\u0430\u043c\u043e\u0440\u043e\u0437\u043a\u0438, \u041c\u043e\u043d\u0441\u0442\u0440\u044b \u0438\u043c\u0435\u044e\u0442 #% \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u0448\u0430\u043d\u0441\u0430 \u043d\u0430\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0448\u043e\u043a\u0430, #% \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u043f\u0443\u0442\u0435\u0432\u044b\u0445 \u043a\u0430\u043c\u043d\u0435\u0439, \u043d\u0430\u0445\u043e\u0434\u0438\u043c\u044b\u0445 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438","5396":"\u041c\u043e\u043d\u0441\u0442\u0440\u044b \u0438\u043c\u0435\u044e\u0442 #% \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043d\u0430\u043a\u043e\u043f\u043b\u0435\u043d\u0438\u044f \u0448\u043a\u0430\u043b\u044b \u043e\u0433\u043b\u0443\u0448\u0435\u043d\u0438\u044f, #% \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u043f\u0443\u0442\u0435\u0432\u044b\u0445 \u043a\u0430\u043c\u043d\u0435\u0439, \u043d\u0430\u0445\u043e\u0434\u0438\u043c\u044b\u0445 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438","5383":"\u041c\u043e\u043d\u0441\u0442\u0440\u044b \u0438\u043c\u0435\u044e\u0442 #% \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043f\u043e\u0440\u043e\u0433\u0430 \u043e\u0433\u043b\u0443\u0448\u0435\u043d\u0438\u044f, \u041c\u043e\u043d\u0441\u0442\u0440\u044b \u0438\u043c\u0435\u044e\u0442 #% \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043f\u043e\u0440\u043e\u0433\u0430 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0439, #% \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u043f\u0443\u0442\u0435\u0432\u044b\u0445 \u043a\u0430\u043c\u043d\u0435\u0439, \u043d\u0430\u0445\u043e\u0434\u0438\u043c\u044b\u0445 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438","5437":"\u041c\u043e\u043d\u0441\u0442\u0440\u044b, \u043f\u0440\u0438\u043d\u0435\u0441\u0435\u043d\u043d\u044b\u0435 \u0432 \u0436\u0435\u0440\u0442\u0432\u0443 \u043d\u0430 \u0430\u043b\u0442\u0430\u0440\u044f\u0445 \u0420\u0438\u0442\u0443\u0430\u043b\u0430 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438, \u0434\u0430\u0440\u0443\u044e\u0442 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u043d\u0443\u044e \u043d\u0430 #% \u0434\u0430\u043d\u044c","5413":"\u041c\u043e\u043d\u0441\u0442\u0440\u044b \u043f\u043e\u043b\u0443\u0447\u0430\u044e\u0442 #% \u0443\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u0438\u0435 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0443\u0440\u043e\u043d\u0430 \u043e\u0442 \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0443\u0434\u0430\u0440\u043e\u0432, #% \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432